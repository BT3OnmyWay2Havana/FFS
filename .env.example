# Copy this file to .env and fill it in. Never commit .env.

# --- Required ---------------------------------------------------------------
# From https://console.anthropic.com (Settings > API keys)
ANTHROPIC_API_KEY=
# From @BotFather in Telegram, and your own chat id (see README)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# A long random string. Generate one with:  openssl rand -hex 24
DASHBOARD_TOKEN=

# --- Optional: news and sentiment desk (LunarCrush, paid plan for social data)
LUNARCRUSH_API_KEY=

# --- Market -----------------------------------------------------------------
EXCHANGE_ID=kraken
QUOTE=USD
WATCHLIST=BTC,ETH,SOL,XRP,ADA,DOGE,LINK,AVAX,DOT,LTC
MIN_QUOTE_VOLUME=5000000

# --- Claude -----------------------------------------------------------------
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
CLAUDE_MAX_CALLS_PER_DAY=48

# --- Risk limits ------------------------------------------------------------
START_EQUITY=10000
RISK_PER_TRADE_PCT=1
MAX_POSITION_PCT=10
MAX_OPEN_POSITIONS=4
MAX_DAILY_LOSS_PCT=3
MAX_ATR_PCT=8
MIN_REWARD_RISK=1.5
MAX_PRICE_DRIFT_PCT=1
SYMBOL_COOLDOWN_MIN=240
PROPOSAL_TTL_MIN=30

# --- Paper trading costs ----------------------------------------------------
PAPER_FEE_PCT=0.40
PAPER_SLIPPAGE_PCT=0.05

# --- Live trading: leave alone until you have run paper for weeks -----------
TRADING_MODE=paper
LIVE_CONFIRM=
LIVE_DRY_RUN=true
LIVE_MAX_ORDER_VALUE=50
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# --- Schedules (seconds) ----------------------------------------------------
SCAN_EVERY_SEC=300
WHALE_EVERY_SEC=120
NEWS_EVERY_SEC=1800
CHIEF_EVERY_SEC=900
MONITOR_EVERY_SEC=30
DAILY_SUMMARY_HOUR_UTC=7
